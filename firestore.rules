rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check if current user is owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Companies subcollection
      match /companies/{companyId} {
        allow read, write: if isOwner(userId);
      }
      
      // Contacts subcollection
      match /contacts/{contactId} {
        allow read, write: if isOwner(userId);
      }
      
      // Leads subcollection
      match /leads/{leadId} {
        allow read, write: if isOwner(userId);
      }
      
      // Services subcollection
      match /services/{serviceId} {
        allow read, write: if isOwner(userId);
      }
      
      // Campaigns subcollection
      match /campaigns/{campaignId} {
        allow read, write: if isOwner(userId);
      }
      
      // Message templates subcollection
      match /messages/{messageId} {
        allow read, write: if isOwner(userId);
      }
      
      // Sequences / Follow-up strategies subcollection
      match /sequences/{sequenceId} {
        allow read, write: if isOwner(userId);
      }
      
      // Tasks / Actions subcollection
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }
      
      // Interactions / History subcollection
      match /interactions/{interactionId} {
        allow read, write: if isOwner(userId);
      }
      
      // AB Tests & Analytics subcollection
      match /ab_tests/{abTestId} {
        allow read, write: if isOwner(userId);
      }
      
      // Sales Engine / Knowledge Items
      match /sales_engine/{itemId} {
        allow read, write: if isOwner(userId);
      }
      
      // Settings subcollection
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // Conflict audit log subcollection
      match /conflicts/{conflictId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Connection test document
    match /test/connection {
      allow read: if true;
    }
  }
}
